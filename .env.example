# Model providers
GROQ_API_KEY=
TAVILY_API_KEY=
KG_MODEL=openai/gpt-oss-120b
LOCAL_MODEL_PATH=local_qwen_3b

# Runtime
RAG_ENV=development
RAG_LOG_LEVEL=INFO
RAG_RETRIEVAL_TOP_K=12
RAG_CONFIDENCE_THRESHOLD=0.60
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_ENABLE_EMBEDDINGS=true
RAG_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Storage: file (zero infrastructure) or neo4j
RAG_STORE_BACKEND=file
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j
